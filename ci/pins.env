# The one place each pinned version the app's gate and CI use is written.
# gate.sh sources it; every workflow job adds it to its environment
# (`grep -E '^[A-Z0-9_]+=' app/ci/pins.env >> "$GITHUB_ENV"`) and reads each
# pin from there, so no workflow holds a copy; ci/check-pins.sh checks that,
# and the copies outside the workflows. Lines are comments, blank, or
# KEY=value with a plain value.

# The core commit the app builds against: mobile/Cargo.toml's git
# dependencies name it as their rev.
CORE_REV=6beadae98da55b8e055bd4e575ed69b373ee9102

# Rust, as core pins it: stable (rust-toolchain.toml's channel must give it,
# and CI sets RUSTUP_TOOLCHAIN to it), and the nightly cargo-udeps runs on.
RUST_STABLE=1.99.1
RUST_NIGHTLY=nightly-2026-10-27

# Cargo tools, at core's pins (core/ci/pins.env), so that both repositories
# judge alike.
CARGO_DENY=0.20.2
CARGO_AUDIT=0.22.2
CARGO_MACHETE=0.9.2
CARGO_VET=0.10.3
CARGO_UDEPS=0.1.61
TYPOS=1.51.1

# semgrep: the release, and the index digest of its image, as core pins them.
SEMGREP=1.182.0
SEMGREP_IMAGE_DIGEST=sha256:4a34048c04fef049f71665047f074cffb00cc3d89482f965a5cd151d589237af

# The Tauri command line (the tauri-cli crate), which builds the APKs and the
# iOS app.
TAURI_CLI=2.12.4

# The Android build: Temurin's JDK; the NDK (its version as the SDK names its
# directory; r30); the platform, which is the APK's compileSdk and targetSdk
# and the emulator's API level; the build tools, whose aapt2 reads the merged
# manifest (ci/check-manifest.sh).
JDK=25.0.5+8
ANDROID_NDK=30.0.16248370
ANDROID_PLATFORM=37
ANDROID_BUILD_TOOLS=37.0.0
# The emulator CI runs: its build (37.2.13), and the system image's API level
# and revision (google_apis, x86_64).
ANDROID_EMULATOR_BUILD=16740729
ANDROID_SYSTEM_IMAGE_API=37.0
ANDROID_SYSTEM_IMAGE_REVISION=8

# iOS: the Xcode that builds for the simulator (core's pin), and XcodeGen,
# which Tauri's `ios init` runs: the release and the SHA-256 of its
# xcodegen.zip, as the release lists it.
XCODE=26.6
XCODEGEN=2.46.0
XCODEGEN_SHA256=4d9e34b62172d645eed6457cac13fc222569974098ef4ee9c3368bedf0196806
