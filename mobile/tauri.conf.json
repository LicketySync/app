{
  "productName": "LicketySync",
  "version": "0.0.1",
  "identifier": "com.licketysync.mobile",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LicketySync"
      }
    ],
    "security": {
      "csp": "default-src 'self'",
      "freezePrototype": true,
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      },
      "capabilities": ["status"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "iOS": {
      "frameworks": ["SystemConfiguration"]
    }
  }
}
